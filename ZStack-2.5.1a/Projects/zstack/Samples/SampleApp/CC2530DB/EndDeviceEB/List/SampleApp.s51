        MOVX    @DPTR,A
        INC     DPTR
        CLR     A
        MOVX    @DPTR,A
//  138 
//  139     SampleApp_P2P_DstAddr.addrMode = (afAddrMode_t)Addr16Bit;
        MOV     DPTR,#SampleApp_P2P_DstAddr + 8
        MOV     A,#0x2
