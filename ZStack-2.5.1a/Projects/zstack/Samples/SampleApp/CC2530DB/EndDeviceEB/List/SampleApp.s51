//  141     SampleApp_P2P_DstAddr.addr.shortAddr = 0x0000;  // 发给协调器
        MOV     DPTR,#SampleApp_P2P_DstAddr
        CLR     A
        MOVX    @DPTR,A
        INC     DPTR
        MOVX    @DPTR,A
//  142 }
        MOV     R7,#0x1
        LJMP    ?BANKED_LEAVE_XDATA
