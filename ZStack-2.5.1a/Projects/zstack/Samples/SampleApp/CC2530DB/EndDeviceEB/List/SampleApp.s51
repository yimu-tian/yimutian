        RSEG BANK_RELAYS:CODE:REORDER:NOROOT(0)
??SampleApp_CallBack?relay:
        LCALL   ?BDISPATCH
        DATA
        DC24    SampleApp_CallBack

        RSEG XDATA_ROM_C:CONST:REORDER:NOROOT(0)
        DATA8
`?<Constant "Sending: ID:%d T:%d H...">`:
        DB "Sending: ID:%d T:%d H:%d L:%d M135:%d M7:%d\015\012"

        END
