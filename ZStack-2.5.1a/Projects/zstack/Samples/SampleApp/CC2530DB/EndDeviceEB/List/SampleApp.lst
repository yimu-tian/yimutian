    193          /*********************************************************************
    194           * @fn      SampleApp_ProcessMSGCmd
    195           */
    196          void SampleApp_ProcessMSGCmd( afIncomingMSGPacket_t *pkt )
    197          {
    198              switch (pkt->clusterId)
    199              {
    200              case SAMPLEAPP_P2P_CLUSTERID:
    201          #ifdef ZDO_COORDINATOR
    202                  {
    203                      sensor_data_t *pData = (sensor_data_t *)pkt->cmd.Data;
    204          
    205                      uint8 id = pData->id;
    206                      uint8 t = pData->temperature;
    207                      uint8 h = pData->humidity;
    208                      uint16 light = pData->light;
    209                      uint16 mq135 = pData->mq135;
    210                      uint16 mq7 = pData->mq7;
    211          
    212                      // OLED 显示（保持原有代码）
    213                      char line1[20], line2[20], line3[20], line4[20];
    214                      sprintf(line1, "ID:%d T:%dC H:%d%%", id, t, h);
    215                      sprintf(line2, "Light:%d", light);
    216                      sprintf(line3, "MQ135:%d", mq135);
    217                      sprintf(line4, "MQ7:%d", mq7);
    218                      OLED_Clear();
    219                      OLED_ShowString(0, 0, line1);
    220                      OLED_ShowString(0, 2, line2);
    221                      OLED_ShowString(0, 4, line3);
    222                      OLED_ShowString(0, 6, line4);
    223          
    224                      // ========== 新增：通过串口输出数据 ==========
    225                      char uartBuf[80];
    226                      sprintf(uartBuf, "ID:%d T:%d H:%d L:%d M135:%d M7:%d\r\n",
    227                              id, t, h, light, mq135, mq7);
    228                      HalUARTWrite(0, (uint8*)uartBuf, strlen(uartBuf));
    229                      // =======================================
    230          
    231                      // 蜂鸣器报警逻辑
    232                      if (t > 35 || h < 30 || light < 100 || mq135 > 2000 || mq7 > 2000)
    233                          P0_7 = 0;
    234                      else
    235                          P0_7 = 1;
    236                  }
    237          #endif
    238                  break;
    239          
    240              case SAMPLEAPP_PERIODIC_CLUSTERID:
    241                  // 处理其他消息（可根据需要添加）
    242                  break;
    243          
    244              default:
    245                  break;
    246              }
    247          }
