        RSEG BANKED_CODE:CODE:NOROOT(0)
//   12 static void I2C_Start(void)
I2C_Start:
        CFI Block cfiBlock0 Using cfiCommon0
        CFI Function I2C_Start
        CODE
//   13 {
        ; Saved register size: 0
        ; Auto size: 0
//   14     OLED_SDA = 1; OLED_SCL = 1; I2C_Delay();
        SETB    0x90.1
        SETB    0x90.0
        NOP
        NOP
//   15     OLED_SDA = 0; I2C_Delay(); OLED_SCL = 0;
        CLR     0x90.1
        NOP
        NOP
        CLR     0x90.0
//   16 }
        LJMP    ?BRET
        CFI EndBlock cfiBlock0
        REQUIRE _A_P1
//   17 

        RSEG BANKED_CODE:CODE:NOROOT(0)
//   18 static void I2C_Stop(void)
I2C_Stop:
        CFI Block cfiBlock1 Using cfiCommon0
        CFI Function I2C_Stop
        CODE
//   19 {
        ; Saved register size: 0
        ; Auto size: 0
//   20     OLED_SDA = 0; OLED_SCL = 1; I2C_Delay();
        CLR     0x90.1
        SETB    0x90.0
        NOP
        NOP
//   21     OLED_SDA = 1;
        SETB    0x90.1
//   22 }
        LJMP    ?BRET
        CFI EndBlock cfiBlock1
        REQUIRE _A_P1
//   23 

        RSEG BANKED_CODE:CODE:NOROOT(0)
//   24 static uint8 I2C_WriteByte(uint8 dat)
I2C_WriteByte:
        CFI Block cfiBlock2 Using cfiCommon0
        CFI Function I2C_WriteByte
        CODE
//   25 {
        ; Saved register size: 0
        ; Auto size: 0
        MOV     A,R1
        MOV     R2,A
//   26     uint8 i, ack;
//   27     for(i=0; i<8; i++)
        MOV     R0,#0x8
//   28     {
//   29         OLED_SDA = (dat & 0x80) ? 1 : 0;
??I2C_WriteByte_0:
        MOV     A,R2
        MOV     C,0xE0 /* A   */.7
        MOV     0x90.1,C
//   30         dat <<= 1;
        CLR     C
        RLC     A
        MOV     R2,A
//   31         OLED_SCL = 1; I2C_Delay(); OLED_SCL = 0;
        SETB    0x90.0
        NOP
        NOP
        CLR     0x90.0
//   32     }
        DEC     R0
        MOV     A,R0
        JNZ     ??I2C_WriteByte_0
//   33     OLED_SDA = 1; OLED_SCL = 1; I2C_Delay();
        SETB    0x90.1
        SETB    0x90.0
        NOP
        NOP
//   34     ack = OLED_SDA; OLED_SCL = 0;
        MOV     A,0x90
        CLR     0x90.0
//   35     return ack;
        MOV     C,0xE0 /* A   */.1
        CLR     A
        RLC     A
        MOV     R1,A
        LJMP    ?BRET
        CFI EndBlock cfiBlock2
        REQUIRE _A_P1
//   36 }
//   37 

        RSEG BANKED_CODE:CODE:NOROOT(0)
//   38 static void OLED_WriteCmd(uint8 cmd)
OLED_WriteCmd:
        CFI Block cfiBlock3 Using cfiCommon0
        CFI Function OLED_WriteCmd
        CODE
//   39 {
        FUNCALL OLED_WriteCmd, I2C_Start
        LOCFRAME ISTACK, 0, STACK
        LOCFRAME PSTACK, 0, STACK
